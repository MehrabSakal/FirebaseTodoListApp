<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  INSTRUCTIONS:
  1. Go to Firebase Console (https://console.firebase.google.com/)
  2. Create an iOS App with your Bundle Identifier (e.g. com.yourname.FirebaseTodoListApp)
  3. Download your real "GoogleService-Info.plist" file.
  4. Replace this file with your downloaded "GoogleService-Info.plist" in your Xcode project.
  5. Ensure "Copy items if needed" and "Add to targets" are checked in Xcode.
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>AIzaSyExampleKeyReplaceWithYourOwnFromFirebase</string>
	<key>GCM_SENDER_ID</key>
	<string>123456789012</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.yourname.FirebaseTodoListApp</string>
	<key>PROJECT_ID</key>
	<string>your-firebase-project-id</string>
	<key>STORAGE_BUCKET</key>
	<string>your-firebase-project-id.appspot.com</string>
	<key>IS_ADS_ENABLED</key>
	<false></false>
	<key>IS_ANALYTICS_ENABLED</key>
	<false></false>
	<key>IS_APPINVITE_ENABLED</key>
	<true></true>
	<key>IS_GCM_ENABLED</key>
	<true></true>
	<key>IS_SIGNIN_ENABLED</key>
	<true></true>
	<key>GOOGLE_APP_ID</key>
	<string>1:123456789012:ios:abcdef1234567890</string>
</dict>
</plist>
